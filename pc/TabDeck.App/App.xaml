<Application x:Class="TabDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:TabDeck">
    <Application.Resources>

        <!-- Dal nome di un'icona Lucide al suo tracciato: le voci della barra e i
             gettoni del deck disegnano le stesse icone del tablet. -->
        <local:FormaIcona x:Key="FormaIcona" />

        <!-- ==============================================================
             LE MISURE CHE CAMBIANO CON LA FINESTRA

             Sono gli unici valori che l'applicazione riscrive mentre gira, e
             per questo si leggono con DynamicResource invece che con Static:
             cambiandoli qui, cambia tutto quello che li usa, in una volta e
             senza che nessuna pagina debba saperlo.

             Chi li riscrive e' MainWindow.Misure.cs, che guarda quanto e'
             larga e alta la finestra. I valori scritti qui sono quelli della
             finestra larga: e' come si apre.
             ============================================================== -->

        <Thickness x:Key="SpazioPagina">24,22,24,16</Thickness>
        <sys:Double x:Key="LarghezzaBarra">196</sys:Double>
        <Thickness x:Key="SpazioBarra">11,10,11,16</Thickness>
        <Thickness x:Key="SpazioVoceBarra">14,0,10,0</Thickness>

        <!-- Con la barra stretta i nomi delle voci non ci stanno: restano i
             glifi, e a dire cosa sono ci pensa il suggerimento. Le
             intestazioni dei due gruppi diventano allora una riga sottile,
             che e' l'unica cosa che sopravvive alla larghezza di un'icona. -->
        <Visibility x:Key="NomiBarra">Visible</Visibility>
        <Visibility x:Key="SegniBarra">Collapsed</Visibility>

        <!-- ==============================================================
             COLORI

             Gli stessi valori che DeckView.java usa sul tablet: guardando i
             due schermi affiancati devono sembrare la stessa cosa.
             ============================================================== -->

        <SolidColorBrush x:Key="Sfondo"       Color="#0A0B0D" />
        <SolidColorBrush x:Key="Pannello"     Color="#131417" />
        <SolidColorBrush x:Key="PannelloAlto" Color="#1A1B1F" />
        <SolidColorBrush x:Key="Campo"        Color="#0E0F11" />
        <SolidColorBrush x:Key="Bordo"        Color="#26282D" />
        <SolidColorBrush x:Key="BordoVivo"    Color="#3A3D44" />
        <SolidColorBrush x:Key="Testo"        Color="#D9DBE0" />
        <SolidColorBrush x:Key="TestoForte"   Color="#F0F1F3" />
        <SolidColorBrush x:Key="TestoTenue"   Color="#8A8D95" />
        <SolidColorBrush x:Key="Acceso"       Color="#3DDC84" />
        <SolidColorBrush x:Key="Spento"       Color="#5C5F66" />
        <SolidColorBrush x:Key="Azione"       Color="#4A7BF0" />
        <SolidColorBrush x:Key="AzioneSopra"  Color="#5B8CFF" />
        <SolidColorBrush x:Key="AzioneSotto"  Color="#3D68D8" />
        <SolidColorBrush x:Key="Accento"      Color="#5B8CFF" />
        <SolidColorBrush x:Key="Attenzione"   Color="#E0A64B" />
        <SolidColorBrush x:Key="Errore"       Color="#E06C63" />

        <!-- Il quadratino del marchio, in alto a sinistra: l'unico posto dove
             l'azzurro sfuma nel viola. -->
        <LinearGradientBrush x:Key="Marchio" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8CFF" Offset="0" />
            <GradientStop Color="#8B5BFF" Offset="1" />
        </LinearGradientBrush>

        <!-- La sagoma del tablet attorno al deck: una cornice scura con un filo
             di luce in cima, come il bordo di un pannello vero. -->
        <LinearGradientBrush x:Key="Cornice" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E1F23" Offset="0" />
            <GradientStop Color="#141518" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Sagoma" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Cornice}" />
            <Setter Property="BorderBrush" Value="#2A2C31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="Padding" Value="26" />
            <!-- Niente ombra: un effetto in WPF passa tutto quel che contiene
                 per una bitmap, e il deck dentro diventerebbe sfocato. -->
        </Style>

        <!-- Il rettangolo tratteggiato del fuoco di Windows su fondo scuro non
             si vede: il fuoco lo disegnano i template, uno per uno. -->
        <Style x:Key="NienteFuoco">
            <Setter Property="Control.FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- ==============================================================
             TESTO
             ============================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="Titolo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Testo di spiegazione: grigio, va a capo, non compete col resto. -->
        <Style x:Key="Aiuto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <!-- Etichetta di un campo, allineata al controllo che descrive. -->
        <Style x:Key="Etichetta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="Numero" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,0,0,2" />
        </Style>

        <!-- ==============================================================
             PULSANTI
             ============================================================== -->

        <Style TargetType="Button" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Background" Value="#1E2024" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bordo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#282A30" />
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#151619" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bordo" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Il verde e' riservato a quello che manda davvero qualcosa: mandare
             lo schermo, salvare il deck sul tablet. Uno per schermata. -->
        <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Azione}" />
            <Setter Property="BorderBrush" Value="{StaticResource AzioneSopra}" />
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bordo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="{StaticResource AzioneSopra}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="{StaticResource AzioneSotto}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bordo" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsante piccolo senza fondo: sta accanto a un campo o dentro una
             barra di attrezzi, e non deve pesare quanto un comando vero. -->
        <Style x:Key="Tenue" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="9,4" />
        </Style>

        <!-- ==============================================================
             LA BARRA DEI COMANDI

             I comandi che agiscono su quello che si e' scelto — togli,
             duplica, sposta, prova — erano file di pulsantini uno accanto
             all'altro, ognuno con la sua cornice: sei rettangoli in fila
             sembrano sei cose diverse, e nessuna delle sei sembra importante.

             Adesso stanno dentro una cornice sola, senza averne una propria, e
             i gruppi si separano con una lineetta: « aggiungi » da una parte,
             « sposta » dall'altra. E' lo stesso numero di comandi, ma si legge
             come un attrezzo unico invece che come un mucchio.
             ============================================================== -->

        <Style x:Key="Barra" TargetType="Border">
            <Setter Property="Background" Value="#111215" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="Comando" TargetType="Button" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bordo" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#26282D" />
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#0E0F11" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#26282D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dentro la barra, quello che toglie: grigio finche' non lo sfiori. -->
        <Style x:Key="ComandoRischio" TargetType="Button" BasedOn="{StaticResource Comando}">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Errore}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quello che manda davvero qualcosa, dentro una barra. -->
        <Style x:Key="ComandoForte" TargetType="Button" BasedOn="{StaticResource Comando}">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- La lineetta fra un gruppo di comandi e il successivo. -->
        <Style x:Key="Divisore" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="5,5,5,5" />
            <Setter Property="Background" Value="{StaticResource Bordo}" />
        </Style>

        <!-- Toglie qualcosa: grigio finche' non lo sfiori, rosso quando lo fai. -->
        <Style x:Key="Rischio" TargetType="Button" BasedOn="{StaticResource Tenue}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Errore}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RepeatTenue" TargetType="RepeatButton" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bordo" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#282A30" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#151619" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gettone a due stati: i glifi e i colori del deck si scelgono cosi',
             premendo quello che si vuole invece di scriverne il codice. -->
        <Style x:Key="Gettone" TargetType="ToggleButton" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Background" Value="#1A1B1F" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bordo" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                                <Setter TargetName="bordo" Property="Background" Value="#1E2A45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Il gettone di un'icona del deck: l'icona prende il colore del testo,
             e scelta si accende d'azzurro. -->
        <Style x:Key="GettoneIcona" TargetType="ToggleButton" BasedOn="{StaticResource Gettone}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Foreground" Value="#C9CBD0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Il gettone di un colore e' il colore: quando e' scelto cambia solo
             la cornice, altrimenti sparirebbe proprio quello che si sta guardando. -->
        <Style x:Key="GettoneColore" TargetType="ToggleButton" BasedOn="{StaticResource Gettone}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bordo" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="8"
                                Padding="0">
                            <Border x:Name="segno" BorderBrush="{StaticResource Sfondo}"
                                    BorderThickness="0" CornerRadius="6" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                                <Setter TargetName="bordo" Property="BorderThickness" Value="2" />
                                <Setter TargetName="segno" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             CAMPI DI TESTO
             ============================================================== -->

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Campo}" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{StaticResource TestoForte}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accento}" />
            <!-- Centrato sta bene a una riga sola; un campo che ne accetta piu'
                 di una deve cominciare in alto, o il testo galleggia a meta'. -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bordo" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <!-- Niente VerticalAlignment qui dentro: al centro o
                                 in alto ci pensa VerticalContentAlignment del
                                 campo, e la barra di scorrimento resta in fondo
                                 al riquadro invece di attaccarsi al testo. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bordo" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==============================================================
             ELENCHI
             ============================================================== -->

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Campo}" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bordo" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#1C1D21" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#1E2A45" />
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             ELENCO A DISCESA
             ============================================================== -->

        <Style x:Key="FrecciaCombo" TargetType="ToggleButton" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bordo" Background="{StaticResource Campo}"
                                BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="8">
                            <Path x:Name="freccia" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M 0,0 L 8,0 L 4,5 Z"
                                  Fill="{StaticResource TestoTenue}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                                <Setter TargetName="freccia" Property="Fill" Value="{StaticResource Testo}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bordo" Property="BorderBrush" Value="{StaticResource Accento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource FrecciaCombo}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{StaticResource PannelloAlto}"
                                        BorderBrush="{StaticResource BordoVivo}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,3,0,0" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bordo" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#1E2A45" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             SPUNTE
             ============================================================== -->

        <Style TargetType="CheckBox" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="scatola" Width="17" Height="17" CornerRadius="6"
                                    Background="{StaticResource Campo}"
                                    BorderBrush="{StaticResource Bordo}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="segno" Visibility="Collapsed"
                                      Data="M 2,6 L 5.5,9.5 L 11,3" Stroke="White"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segno" Property="Visibility" Value="Visible" />
                                <Setter TargetName="scatola" Property="BorderBrush" Value="{StaticResource Accento}" />
                                <Setter TargetName="scatola" Property="Background" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="scatola" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="scatola" Property="BorderBrush" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="cerchio" Width="17" Height="17" CornerRadius="9"
                                    Background="{StaticResource Campo}"
                                    BorderBrush="{StaticResource Bordo}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="punto" Width="7" Height="7" Visibility="Collapsed"
                                         Fill="White" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="punto" Property="Visibility" Value="Visible" />
                                <Setter TargetName="cerchio" Property="BorderBrush" Value="{StaticResource Accento}" />
                                <Setter TargetName="cerchio" Property="Background" Value="{StaticResource Accento}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cerchio" Property="BorderBrush" Value="{StaticResource BordoVivo}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             CURSORI A SCORRIMENTO
             ============================================================== -->

        <Style x:Key="ManopolaCursore" TargetType="Thumb" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="alone" Width="22" Height="22" Fill="#335B8CFF" Opacity="0" />
                            <Ellipse x:Name="manopola" Width="14" Height="14"
                                     Fill="{StaticResource Testo}"
                                     Stroke="{StaticResource Sfondo}" StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="manopola" Property="Fill" Value="{StaticResource TestoForte}" />
                                <Setter TargetName="alone" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="manopola" Property="Fill" Value="{StaticResource Accento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BinarioCursore" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="18" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La parte gia' percorsa la disegna il pezzo di binario a sinistra
             della manopola: e' l'unico che sa quanto e' lungo. -->
        <Style x:Key="BinarioPercorso" TargetType="RepeatButton" BasedOn="{StaticResource BinarioCursore}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="18">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource Azione}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource Campo}"
                                    BorderBrush="{StaticResource Bordo}" BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BinarioPercorso}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ManopolaCursore}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BinarioCursore}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             BARRE DI SCORRIMENTO

             Sottili e senza frecce: la finestra e' fatta di pannelli scuri, e
             la barra grigia di Windows ci spiccava come una cucitura.
             ============================================================== -->

        <Style x:Key="ManopolaBarra" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="corpo" Background="#2C2E33" CornerRadius="6" Margin="3,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="corpo" Property="Background" Value="#3E4148" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ManopolaBarra}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="11" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             LA BARRA DI SINISTRA

             Le schede non stanno in fila sopra il contenuto ma in colonna a
             sinistra, divise in due gruppi: quello che si usa e quello che si
             regola. A reggere il cambio di pagina resta un TabControl - sono i
             suoi TabItem, messi in uno StackPanel invece che in una riga.
             ============================================================== -->

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Sfondo}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Pannello}"
                                    BorderBrush="{StaticResource Bordo}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True"
                                                Width="{DynamicResource LarghezzaBarra}"
                                                Margin="{DynamicResource SpazioBarra}" />
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="1" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una voce della barra: il glifo sta nel Tag, il nome nell'intestazione. -->
        <Style TargetType="TabItem" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Serve quando la barra si stringe e restano i soli glifi: senza,
                 un quadratino non direbbe piu' dove porta. -->
            <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="36" Margin="0,1">
                            <Border x:Name="fondo" CornerRadius="9" Background="Transparent" />
                            <!-- Il segno della voce scelta e' una barretta a
                                 sinistra: in colonna, una riga sotto non si
                                 leggerebbe. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource SpazioVoceBarra}"
                                        VerticalAlignment="Center">
                                <!-- L'icona Lucide della voce: il nome sta nel Tag. -->
                                <Viewbox Width="17" Height="17" Margin="0,0,11,0" VerticalAlignment="Center">
                                    <Path x:Name="icona" Width="24" Height="24"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FormaIcona}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  Visibility="{DynamicResource NomiBarra}"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Testo}" />
                                <Setter TargetName="fondo" Property="Background" Value="#1A1B1F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                                <Setter TargetName="fondo" Property="Background" Value="#1C1E23" />
                                <Setter TargetName="icona" Property="Stroke" Value="{StaticResource Accento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- L'intestazione di un gruppo di voci: e' una scheda anche lei, ma
             spenta. Non si sceglie, sta li' a dire dove comincia il gruppo. -->
        <Style x:Key="GruppoBarra" TargetType="TabItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Header}" Margin="15,17,0,6"
                                       Visibility="{DynamicResource NomiBarra}"
                                       FontFamily="Segoe UI" FontSize="10" FontWeight="Normal"
                                       Foreground="#5D6068" />
                            <Border Height="1" Margin="8,13,8,10" Background="#26282D"
                                    VerticalAlignment="Center"
                                    Visibility="{DynamicResource SegniBarra}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             RIQUADRI

             Non la cornice scanalata di Windows: un pannello con l'intestazione
             sopra, in piccolo, come una didascalia.
             ============================================================== -->

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <!-- Un TextBlock esplicito: dal ContentPresenter il
                                 testo prendeva lo stile generale dei TextBlock, e
                                 l'intestazione usciva bianca e grande come il
                                 contenuto invece che piccola e grigia. -->
                            <TextBlock Text="{TemplateBinding Header}" Margin="2,0,0,7"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" />
                            <Border Background="{StaticResource Pannello}"
                                    BorderBrush="{StaticResource Bordo}" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pannello semplice, senza intestazione: serve dove un riquadro con
             la didascalia sarebbe di troppo. -->
        <Style x:Key="Riquadro" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Pannello}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- ==============================================================
             SUGGERIMENTI
             ============================================================== -->

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource PannelloAlto}"
                                BorderBrush="{StaticResource BordoVivo}" BorderThickness="1"
                                CornerRadius="8" Padding="9,6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             SCHEDE DI CONTENUTO

             La plancia e' fatta di riquadri: un fondo appena piu' chiaro dello
             sfondo, sfumato verso il basso, cosi' che il bordo non sia l'unica
             cosa che li stacca dal fondo.
             ============================================================== -->

        <LinearGradientBrush x:Key="VeloScheda" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17181C" Offset="0" />
            <GradientStop Color="#131417" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="VeloIntestazione" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121316" Offset="0" />
            <GradientStop Color="#111214" Offset="0.6" />
            <GradientStop Color="#121316" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Scheda" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VeloScheda}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Il riquadro di una misura: piccolo, tre in fila. -->
        <Style x:Key="Misuratore" TargetType="Border" BasedOn="{StaticResource Scheda}">
            <Setter Property="Padding" Value="13,11,13,12" />
        </Style>

        <!-- ==============================================================
             TESTO DELLA PLANCIA
             ============================================================== -->

        <!-- Il cappello di un riquadro: minuscolo, tutto maiuscolo. -->
        <Style x:Key="Occhiello" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Lo stato, in grande: e' la prima cosa che si guarda entrando. -->
        <Style x:Key="Grande" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>

        <Style x:Key="Misura" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>

        <!-- Il titolo di una pagina di gestione, con la riga di spiegazione
             sotto: senza, ogni pagina comincia con un modulo da riempire. -->
        <Style x:Key="TitoloPagina" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>

        <Style x:Key="SottotitoloPagina" TargetType="TextBlock" BasedOn="{StaticResource Aiuto}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- ==============================================================
             PULSANTI GRANDI

             Sulla plancia si preme col colpo d'occhio, non cercando: i comandi
             che contano sono alti quasi il doppio di quelli di un modulo.
             ============================================================== -->

        <Style x:Key="Grosso" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PrimarioGrosso" TargetType="Button" BasedOn="{StaticResource Primario}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ==============================================================
             MENU DEL TASTO DESTRO

             Serve dove i comandi sono tanti e quasi tutti rari: su un pulsante
             del deck si taglia, si copia, si sposta in una cartella, si prova.
             Metterli tutti in fila sotto l'elenco vorrebbe dire una barra di
             dieci pulsanti in cui non si trova piu' quello di ogni giorno.

             Lo stile di sistema e' bianco: dentro questa finestra sarebbe un
             foglio di carta acceso in mezzo al buio.
             ============================================================== -->

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PannelloAlto}" />
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordo}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource Bordo}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Testo}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bordo" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                                <!-- La scorciatoia a destra, tenue: chi la legge
                                     una volta poi non riapre piu' il menu. -->
                                <TextBlock Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TestoTenue}"
                                           Text="{TemplateBinding InputGestureText}" />
                                <TextBlock x:Name="freccia" Grid.Column="1" Margin="22,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"
                                           Foreground="{StaticResource TestoTenue}" Text="&#x203A;" />
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                                       HorizontalOffset="2" PopupAnimation="None">
                                    <Border Background="{StaticResource PannelloAlto}"
                                            BorderBrush="{StaticResource Bordo}" BorderThickness="1"
                                            CornerRadius="9" Padding="4" MaxHeight="420">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#1E2A45" />
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="freccia" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==============================================================
             BRICIOLE

             Il percorso fra le cartelle del deck. Ogni pezzo e' un pulsante
             che riporta li': un percorso che si legge e non si preme e' mezzo
             percorso. L'ultimo e' spento perche' e' dove si sta gia'.
             ============================================================== -->

        <Style x:Key="Briciola" TargetType="Button" BasedOn="{StaticResource NienteFuoco}">
            <Setter Property="Foreground" Value="{StaticResource TestoTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bordo" Background="Transparent" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bordo" Property="Background" Value="#1C1D21" />
                                <Setter Property="Foreground" Value="{StaticResource Testo}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TestoForte}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
