                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Indirizzo" Style="{StaticResource Etichetta}" Margin="0,0,10,0" />
                                    <TextBox x:Name="CampoIndirizzo" Width="190" VerticalAlignment="Center" />
                                    <Button Content="Cerca in rete" Margin="8,0,0,0" Click="CercaWifi_Click" />
                                </StackPanel>
                                <Grid Height="96">
                                    <ListBox x:Name="ElencoTrovati"
                                             SelectionChanged="ElencoTrovati_SelectionChanged" />
                                    <!-- Un riquadro vuoto non dice se la ricerca e' andata male
                                         o se non e' mai partita. -->
                                    <TextBlock x:Name="TestoTrovatiVuoto" IsHitTestVisible="False"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TestoTenue}"
                                               Text="Nessun tablet ancora cercato." />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="PORTA">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CampoPorta" Width="96" />
                                <TextBlock Text="La stessa sui due lati. Cambiala solo se e' gia' occupata."
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           Foreground="{StaticResource TestoTenue}" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
